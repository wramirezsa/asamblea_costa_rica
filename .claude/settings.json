{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python etl/*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "WebFetch(domain:www.asamblea.go.cr)",
      "WebFetch(domain:asamblea.go.cr)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat docs/current-state.md"
          }
        ]
      }
    ]
  }
}
